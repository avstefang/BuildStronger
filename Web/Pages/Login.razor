@page "/login"

<PageTitle>Medewerker login — BuildStronger</PageTitle>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="8" md="4">
        <MudText Typo="Typo.h4" GutterBottom="true" Align="Align.Center">Medewerker login</MudText>
        <MudCard>
            <MudCardContent>
                <MudTextField @bind-Value="_email" Label="E-mailadres" InputType="InputType.Email" Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField @bind-Value="_password" Label="Wachtwoord" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" />

                @if (_errorMessage != null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-2">@_errorMessage</MudAlert>
                }
            </MudCardContent>
            <MudCardActions Class="px-4 pb-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="Submit" Disabled="_loading">
                    @if (_loading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                    Inloggen
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _loading = false;
    private string? _errorMessage = null;

    private async Task Submit()
    {
        _loading = true;
        _errorMessage = null;

        // TODO: call API login endpoint and store JWT token
        await Task.Delay(500);
        _errorMessage = "Inloggen is nog niet gekoppeld aan de API.";

        _loading = false;
    }
}
