@page "/register"

<PageTitle>Registreren — BuildStronger</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Maak je account aan</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardContent>
                <MudTextField @bind-Value="_firstName" Label="Voornaam" Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField @bind-Value="_lastName" Label="Achternaam" Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField @bind-Value="_email" Label="E-mailadres" InputType="InputType.Email" Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField @bind-Value="_password" Label="Wachtwoord" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-4" />

                <MudText Typo="Typo.subtitle1" Class="mb-2">Kies een abonnement</MudText>
                <MudRadioGroup @bind-Value="_selectedPlan" Class="mb-4">
                    <MudRadio Value="@("2x_monthly")">2x per week — €29/maand</MudRadio>
                    <MudRadio Value="@("2x_yearly")">2x per week — €299/jaar</MudRadio>
                    <MudRadio Value="@("unlimited_monthly")">Onbeperkt — €55/maand</MudRadio>
                    <MudRadio Value="@("unlimited_yearly")">Onbeperkt — €549/jaar</MudRadio>
                </MudRadioGroup>

                <MudDatePicker @bind-Date="_startDate" Label="Startdatum lidmaatschap" MinDate="DateTime.Today" Variant="Variant.Outlined" Class="mb-4" />

                <MudText Typo="Typo.subtitle1" Class="mb-2">Betaalmethode</MudText>
                <MudRadioGroup @bind-Value="_paymentMethod" Class="mb-4">
                    <MudRadio Value="@("ideal")">iDEAL</MudRadio>
                    <MudRadio Value="@("wero")">Wero</MudRadio>
                </MudRadioGroup>

                @if (_errorMessage != null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMessage</MudAlert>
                }
                @if (_success)
                {
                    <MudAlert Severity="Severity.Success" Class="mb-3">Registratie geslaagd! Controleer je e-mail voor de bevestiging.</MudAlert>
                }
            </MudCardContent>
            <MudCardActions Class="px-4 pb-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="Submit" Disabled="_loading">
                    @if (_loading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                    Betalen & registreren
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _selectedPlan = "unlimited_monthly";
    private string _paymentMethod = "ideal";
    private DateTime? _startDate = DateTime.Today;
    private bool _loading = false;
    private bool _success = false;
    private string? _errorMessage = null;

    private async Task Submit()
    {
        _loading = true;
        _errorMessage = null;

        // TODO: call API to register athlete and process payment
        await Task.Delay(1000); // simulate network call
        _success = true;

        _loading = false;
    }
}
