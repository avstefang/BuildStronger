@page "/"

<PageTitle>BuildStronger — Jouw sportschool</PageTitle>

<MudPaper Elevation="0" Style="background: linear-gradient(135deg, #C62828 0%, #8E0000 100%); border-radius: 16px; padding: 64px 48px; margin-bottom: 48px;">
    <MudText Typo="Typo.h2" Style="color: white; font-weight: 800;">Word sterker.</MudText>
    <MudText Typo="Typo.h5" Style="color: rgba(255,255,255,0.85); margin-top: 8px; margin-bottom: 32px;">
        Groepslessen, spinning, bootcamp en meer. Jouw sportschool, jouw tempo.
    </MudText>
    <MudButton Href="/register" Variant="Variant.Filled" Size="Size.Large"
               Style="background: white; color: #C62828; font-weight: 700; border-radius: 8px;">
        Word lid
    </MudButton>
</MudPaper>

<MudText Typo="Typo.h5" GutterBottom="true">Onze lessen</MudText>
<MudGrid Class="mb-10">
    @foreach (var lesson in _lessons)
    {
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2" Style="height: 100%;">
                <MudCardContent>
                    <MudText Typo="Typo.h6">@lesson.Name</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 600;">@lesson.Location</MudText>
                    <MudText Typo="Typo.body2" Class="mt-1">@lesson.Description</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

<MudText Typo="Typo.h5" GutterBottom="true">Abonnementen</MudText>
<MudGrid>
    @foreach (var plan in _plans)
    {
        <MudItem xs="12" sm="6" md="3">
            <MudCard Outlined="@(!plan.Featured)" Elevation="@(plan.Featured ? 4 : 1)" Style="@(plan.Featured ? "border: 2px solid #C62828; height: 100%;" : "height: 100%;")">
                <MudCardContent>
                    @if (plan.Featured)
                    {
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mb-2">Meest gekozen</MudChip>
                    }
                    <MudText Typo="Typo.h6">@plan.Name</MudText>
                    <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: 800;">€@plan.Price</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@plan.Description</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="/register" Variant="@(plan.Featured ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" FullWidth="true">
                        Aanmelden
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    private record LessonInfo(string Name, string Location, string Description);
    private record PlanInfo(string Name, string Price, string Description, bool Featured = false);

    private List<LessonInfo> _lessons =
    [
        new("Spinning", "Spinningzaal", "4 rijen van 6 fietsen — kies je plek"),
        new("Yoga", "Zaal 1", "Ontspannen flow voor alle niveaus"),
        new("Bootcamp", "Buiten", "Intensieve buitentraining"),
        new("Boxing", "Buiten", "Techniek en conditie"),
        new("Bodyshape", "Zaal 2", "Les om je hele lichaam te vormen"),
        new("Club Power", "Zaal 2", "Krachttraining met gewichten"),
        new("XCO", "Zaal 3", "Crosstraining met XCO-materiaal"),
        new("Total Body Workout", "Zaal 3", "Conditietraining voor het hele lichaam"),
    ];

    private List<PlanInfo> _plans =
    [
        new("2x per week", "29/mnd", "Tot twee keer per week trainen, maandelijks gefactureerd"),
        new("2x per week", "299/jr", "Tot twee keer per week trainen, jaarlijks gefactureerd"),
        new("Onbeperkt", "55/mnd", "Onbeperkt trainen, maandelijks gefactureerd", Featured: true),
        new("Onbeperkt", "549/jr", "Onbeperkt trainen, jaarlijks gefactureerd"),
    ];
}
