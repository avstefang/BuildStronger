@page "/staff/members"
@layout StaffLayout

<PageTitle>Leden — BuildStronger Medewerkers</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Leden</MudText>

<MudTextField @bind-Value="_search" Placeholder="Zoek op naam of e-mail" Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Class="mb-4" />

<MudTable Items="FilteredMembers" Hover="true" Striped="true" Bordered="true">
    <HeaderContent>
        <MudTh>Naam</MudTh>
        <MudTh>E-mail</MudTh>
        <MudTh>Gebruikersnaam</MudTh>
        <MudTh>Abonnement</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Startdatum</MudTh>
        <MudTh>Einddatum</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.Email</MudTd>
        <MudTd>@context.Username</MudTd>
        <MudTd>@context.Plan</MudTd>
        <MudTd>
            <MudChip T="string" Color="@StatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
        </MudTd>
        <MudTd>@context.StartDate.ToShortDateString()</MudTd>
        <MudTd>@context.EndDate.ToShortDateString()</MudTd>
    </RowTemplate>
</MudTable>

@code {
    private record MemberItem(string Name, string Email, string Username, string Plan, string Status, DateTime StartDate, DateTime EndDate);

    private string _search = string.Empty;

    private List<MemberItem> _members =
    [
        new("Anna de Vries", "anna@example.com", "anna_dv", "Onbeperkt — maandelijks", "Actief", DateTime.Today.AddMonths(-3), DateTime.Today.AddMonths(1)),
        new("Tom Bakker", "tom@example.com", "tombakker", "2x per week — jaarlijks", "Actief", DateTime.Today.AddMonths(-6), DateTime.Today.AddMonths(6)),
        new("Sophie Mulder", "sophie@example.com", "sophiem", "Onbeperkt — jaarlijks", "Verlopen", DateTime.Today.AddYears(-1), DateTime.Today.AddDays(-5)),
    ];

    private IEnumerable<MemberItem> FilteredMembers => _members.Where(m =>
        string.IsNullOrWhiteSpace(_search) ||
        m.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        m.Email.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private Color StatusColor(string status) => status switch
    {
        "Actief" => Color.Success,
        "Verlopen" => Color.Error,
        "Geannuleerd" => Color.Warning,
        _ => Color.Default
    };
}
