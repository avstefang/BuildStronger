@page "/staff/workouts"
@layout StaffLayout
@inject ApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Workouts — BuildStronger Staff</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Workouts</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog" Class="mb-4">
    Add workout
</MudButton>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}

<MudTable Items="_workouts" Hover="true" Striped="true" Bordered="true">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Description</MudTh>
        <MudTh>Duration (min)</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.Description</MudTd>
        <MudTd>@context.DurationInMinutes</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditDialog(context)" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteWorkout(context)" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No workouts yet. Add one.</MudText>
    </NoRecordsContent>
</MudTable>

<MudDialog @bind-Visible="_dialogOpen">
    <TitleContent>@(_editTarget == null ? "Add workout" : "Edit workout")</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_form.Name" Label="Name" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_form.Description" Label="Description" Variant="Variant.Outlined" Lines="3" Class="mb-3" />
        <MudNumericField @bind-Value="_form.DurationInMinutes" Label="Duration (minutes)" Variant="Variant.Outlined" Min="1" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _dialogOpen = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveWorkout" Disabled="_loading">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<GetWorkoutDto> _workouts = [];
    private bool _loading;

    private bool _dialogOpen;
    private GetWorkoutDto? _editTarget;
    private WorkoutFormModel _form = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _workouts = await Api.GetListAsync<GetWorkoutDto>("api/workout");
        _loading = false;
    }

    private class WorkoutFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public int DurationInMinutes { get; set; } = 45;
    }

    private void OpenAddDialog()
    {
        _editTarget = null;
        _form = new();
        _dialogOpen = true;
    }

    private void OpenEditDialog(GetWorkoutDto item)
    {
        _editTarget = item;
        _form = new() { Name = item.Name, Description = item.Description, DurationInMinutes = item.DurationInMinutes };
        _dialogOpen = true;
    }

    private async Task SaveWorkout()
    {
        _loading = true;
        try
        {
            bool ok = _editTarget is null
                ? await Api.PostAsync("api/workout", new CreateWorkoutDto(_form.Name, _form.Description, _form.DurationInMinutes))
                : await Api.PutAsync($"api/workout/{_editTarget.Id}", new UpdateWorkoutDto(_form.Name, _form.Description, _form.DurationInMinutes));

            if (ok)
            {
                _dialogOpen = false;
                Snackbar.Add("Workout saved.", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add("Saving failed.", Severity.Error);
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteWorkout(GetWorkoutDto item)
    {
        // Note: deleting a workout also removes its linked lessons (handled server-side).
        if (await Api.DeleteAsync($"api/workout/{item.Id}"))
        {
            Snackbar.Add("Workout removed.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add("Removing failed.", Severity.Error);
        }
    }
}
