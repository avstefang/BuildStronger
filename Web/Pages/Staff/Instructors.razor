@page "/staff/instructors"
@layout StaffLayout

<PageTitle>Instructors — BuildStronger Staff</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Instructors</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenAddDialog" Class="mb-4">
    Add Instructor
</MudButton>

<MudGrid>
    @foreach (var instructor in _instructors)
    {
        <MudItem xs="12" sm="6" md="3">
            <MudCard>
                <MudCardMedia Image="@(instructor.PhotoUrl ?? "https://via.placeholder.com/150")" Height="180" />
                <MudCardContent>
                    <MudText Typo="Typo.h6">@instructor.Name</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="() => OpenEditDialog(instructor)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => DeleteInstructor(instructor)" />
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

<MudDialog @bind-Visible="_dialogOpen">
    <TitleContent>@(_editTarget == null ? "Add Instructor" : "Edit Instructor")</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_form.Name" Label="Full name" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_form.PhotoUrl" Label="Photo URL" Variant="Variant.Outlined" HelperText="Leave empty to set as TBD" Class="mb-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _dialogOpen = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveInstructor">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private record InstructorItem(string Id, string Name, string? PhotoUrl);

    private List<InstructorItem> _instructors =
    [
        new("1", "Lisa van der Berg", null),
        new("2", "Mark Jansen", null),
        new("3", "TBD", null),
    ];

    private bool _dialogOpen = false;
    private InstructorItem? _editTarget = null;
    private InstructorFormModel _form = new();

    private class InstructorFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? PhotoUrl { get; set; }
    }

    private void OpenAddDialog()
    {
        _editTarget = null;
        _form = new();
        _dialogOpen = true;
    }

    private void OpenEditDialog(InstructorItem item)
    {
        _editTarget = item;
        _form = new() { Name = item.Name, PhotoUrl = item.PhotoUrl };
        _dialogOpen = true;
    }

    private void SaveInstructor()
    {
        // TODO: call API to add or update instructor
        _dialogOpen = false;
    }

    private void DeleteInstructor(InstructorItem item)
    {
        // TODO: call API to delete instructor
        _instructors.Remove(item);
    }
}
