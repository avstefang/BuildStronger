<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:MApp.Pages"
    FlyoutBehavior="Disabled"
    Title="BuildStronger">

    <!-- Startup page. Decides between "//home" and "//login" based on a stored token,
         then redirects with an absolute route so it is dropped from the back stack. -->
    <ShellContent
        Title="Laden"
        ContentTemplate="{DataTemplate pages:LoadingPage}"
        Route="loading" />

    <!-- Login lives outside the TabBar so it has no tab; reached via "//login". -->
    <ShellContent
        Title="Inloggen"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="login" />

    <TabBar>
        <ShellContent
            Title="Home"
            Icon="{StaticResource IconHome}"
            ContentTemplate="{DataTemplate pages:HomePage}"
            Route="home" />

        <ShellContent
            Title="Planning"
            Icon="{StaticResource IconPlanning}"
            ContentTemplate="{DataTemplate pages:PlanningPage}"
            Route="planning" />

        <ShellContent
            Title="Boekingen"
            Icon="{StaticResource IconBookings}"
            ContentTemplate="{DataTemplate pages:BookingsPage}"
            Route="bookings" />

        <ShellContent
            Title="Account"
            Icon="{StaticResource IconAccount}"
            ContentTemplate="{DataTemplate pages:AccountPage}"
            Route="account" />
    </TabBar>

</Shell>
