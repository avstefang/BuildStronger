<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MApp.PageModels"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             x:Class="MApp.Pages.AddSubscriptionPage"
             x:DataType="pageModels:AddSubscriptionPageModel"
             Title="Abonnement toevoegen">

    <Grid>
        <ScrollView IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">

                <Label Text="Kies je abonnement" Style="{StaticResource Title2}" />

                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="16">

                        <sf:SfTextInputLayout Hint="Abonnement">
                            <Picker ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" />
                        </sf:SfTextInputLayout>

                        <!-- Only shown once a real plan is selected -->
                        <VerticalStackLayout Spacing="16" IsVisible="{Binding HasSelection}">
                            <sf:SfTextInputLayout Hint="Startdatum lidmaatschap">
                                <DatePicker Date="{Binding StartDate}" MinimumDate="{Binding MinStartDate}" />
                            </sf:SfTextInputLayout>
                            <sf:SfTextInputLayout Hint="Betaalmethode">
                                <Picker ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" />
                            </sf:SfTextInputLayout>
                        </VerticalStackLayout>

                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

                        <Button Text="Doorgaan naar betalen" Command="{Binding ContinueCommand}"
                                IsEnabled="{Binding CanContinue}" Margin="0,8,0,0" />
                        <Button Text="Annuleren" Command="{Binding CancelCommand}"
                                BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Primary}" BorderWidth="1" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
