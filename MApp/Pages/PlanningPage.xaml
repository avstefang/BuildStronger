<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MApp.PageModels"
             xmlns:models="clr-namespace:MApp.Models"
             x:Class="MApp.Pages.PlanningPage"
             x:DataType="pageModels:PlanningPageModel"
             Title="Planning">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <CollectionView ItemsSource="{Binding Classes}"
                        Margin="{StaticResource LayoutPadding}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Text="Geen lessen ingepland." HorizontalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:GymClass">
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnDefinitions="*,Auto" RowSpacing="2">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Name}" Style="{StaticResource Title3}" />
                                <Label Text="{Binding DayLabel, StringFormat='{0}'}" Style="{StaticResource Caption1Strong}" TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding TimeRange}" Style="{StaticResource Body2}" />
                                <Label Text="{Binding Room}" Style="{StaticResource Caption1}" TextColor="{StaticResource Gray500}" />
                                <Label Text="{Binding Instructor}" Style="{StaticResource Caption1}" TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center" HorizontalOptions="End">
                                <Label Text="{Binding SpotsLabel}" Style="{StaticResource Caption1Strong}" HorizontalTextAlignment="End" />
                                <Button Text="Boeken"
                                        IsEnabled="{Binding IsFull, Converter={StaticResource InvertedBoolConverter}}"
                                        Command="{Binding BookClassCommand, Source={RelativeSource AncestorType={x:Type pageModels:PlanningPageModel}}, x:DataType=pageModels:PlanningPageModel}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
