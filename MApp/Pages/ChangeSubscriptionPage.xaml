<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MApp.PageModels"
             x:Class="MApp.Pages.ChangeSubscriptionPage"
             x:DataType="pageModels:ChangeSubscriptionPageModel"
             Title="Abonnement beheren">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">

            <Label Text="Je abonnement" Style="{StaticResource Title2}" />

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding PlanName}" Style="{StaticResource Title3}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding PriceText}" Style="{StaticResource Title3}" TextColor="{StaticResource Primary}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Status" Style="{StaticResource Body2}" TextColor="{StaticResource Gray500}" />
                        <Label Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource Body2Strong}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Startdatum" Style="{StaticResource Body2}" TextColor="{StaticResource Gray500}" />
                        <Label Grid.Column="1" Text="{Binding StartDateText}" Style="{StaticResource Body2Strong}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Einddatum" Style="{StaticResource Body2}" TextColor="{StaticResource Gray500}" />
                        <Label Grid.Column="1" Text="{Binding EndDateText}" Style="{StaticResource Body2Strong}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowAutomaticRenewalOption}">
                        <Label Grid.Column="0" Text="Automatisch verlengen" Style="{StaticResource Body2Strong}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding AutoRenew}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

            <Button Text="Abonnement activeren" Command="{Binding ActivateCommand}"
                    IsVisible="{Binding CanActivate}" Margin="0,8,0,0" />

            <Button Text="Abonnement opzeggen" Command="{Binding CancelSubscriptionCommand}"
                    BackgroundColor="{StaticResource Error}" TextColor="{StaticResource White}"
                    IsVisible="{Binding ShowCancelOption}" />

            <Button Text="Terug" Command="{Binding BackCommand}"
                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Primary}" BorderWidth="1" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
