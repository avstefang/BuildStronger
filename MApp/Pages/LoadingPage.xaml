<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MApp.PageModels"
             x:Class="MApp.Pages.LoadingPage"
             x:DataType="pageModels:LoadingPageModel"
             Shell.NavBarIsVisible="False"
             Title="">

    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Label Text="BuildStronger" Style="{StaticResource Title1}" TextColor="{StaticResource Primary}"
