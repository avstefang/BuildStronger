<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MApp.PageModels"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             x:Class="MApp.Pages.RegisterPage"
             x:DataType="pageModels:RegisterPageModel"
             Title="Registreren">

    <Grid>
        <!-- The form is hidden until the plans have loaded, so the empty picker is never shown. -->
        <ScrollView IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
        <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">

            <Label Text="Maak je account aan" Style="{StaticResource Title2}" />

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="16">

                    <sf:SfTextInputLayout Hint="Voornaam">
                        <Entry Text="{Binding FirstName}" />
                    </sf:SfTextInputLayout>
                    <sf:SfTextInputLayout Hint="Achternaam">
                        <Entry Text="{Binding LastName}" />
                    </sf:SfTextInputLayout>
                    <sf:SfTextInputLayout Hint="E-mailadres">
                        <Entry Keyboard="Email" Text="{Binding Email}" />
                    </sf:SfTextInputLayout>
                    <sf:SfTextInputLayout Hint="Wachtwoord">
                        <Entry IsPassword="True" Text="{Binding Password}" />
                    </sf:SfTextInputLayout>

                    <sf:SfTextInputLayout Hint="Abonnement (optioneel)">
                            <Picker ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" />
                    </sf:SfTextInputLayout>

                    <!-- Only shown once a real plan is selected -->
                    <VerticalStackLayout Spacing="16" IsVisible="{Binding HasSubscription}">
                        <sf:SfTextInputLayout Hint="Startdatum lidmaatschap">
                            <DatePicker Date="{Binding StartDate}" MinimumDate="{Binding MinStartDate}" />
                        </sf:SfTextInputLayout>
                        <sf:SfTextInputLayout Hint="Betaalmethode">
                            <Picker ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" />
                        </sf:SfTextInputLayout>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

                    <Button Text="{Binding SubmitText}" Command="{Binding RegisterCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" Margin="0,8,0,0" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
        </ScrollView>

        <!-- Full-page spinner shown over the whole page while the plans load for the first time. -->
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
