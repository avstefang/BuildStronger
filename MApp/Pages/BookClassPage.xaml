<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MApp.PageModels"
             xmlns:models="clr-namespace:MApp.Models"
             x:Class="MApp.Pages.BookClassPage"
             x:DataType="pageModels:BookClassPageModel"
             Title="Book class">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">

            <!-- Class summary -->
            <Border Style="{StaticResource CardStyle}" BindingContext="{Binding SelectedClass}" x:DataType="models:GymClass">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Name}" Style="{StaticResource Title2}" />
                    <Label Text="{Binding DayLabel}" Style="{StaticResource Caption1Strong}" TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding TimeRange}" Style="{StaticResource Body1}" />
                    <Label Text="{Binding Room}" Style="{StaticResource Caption1}" TextColor="{StaticResource Gray500}" />
                    <Label Text="{Binding Instructor}" Style="{StaticResource Caption1}" TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>
            </Border>

            <!-- Spinning bike picker -->
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}" IsVisible="{Binding IsSpinning}">
                <Label Text="Pick your bike" Style="{StaticResource Title2}" Margin="0,8,0,0" />
                <Label Text="Spinning room — 4 rows of 6 bikes" Style="{StaticResource Caption1}" TextColor="{StaticResource Gray500}" />

                <CollectionView ItemsSource="{Binding Bikes}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="6" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:BikeSpot">
                            <Border StrokeShape="RoundRectangle 8" StrokeThickness="1"
                                    Stroke="{StaticResource Gray200}" HeightRequest="48"
                                    BackgroundColor="{StaticResource LightSecondaryBackground}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectBikeCommand, Source={RelativeSource AncestorType={x:Type pageModels:BookClassPageModel}}, x:DataType=pageModels:BookClassPageModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsTaken}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Gray200}" />
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Number}" HorizontalOptions="Center" VerticalOptions="Center"
                                       Style="{StaticResource Caption1Strong}" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding SelectedBike.Label, StringFormat='Selected: {0}'}"
                       Style="{StaticResource Body1Strong}" TextColor="{StaticResource Primary}"
                       IsVisible="{Binding SelectedBike, Converter={StaticResource IsNotNullConverter}}" />
            </VerticalStackLayout>

            <!-- Actions -->
            <Button Text="Confirm booking" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" Margin="0,12,0,0" />
            <Button Text="Cancel" Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Primary}" BorderWidth="1" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
