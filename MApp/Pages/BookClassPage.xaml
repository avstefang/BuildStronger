<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MApp.PageModels"
             xmlns:models="clr-namespace:MApp.Models"
             x:Class="MApp.Pages.BookClassPage"
             x:DataType="pageModels:BookClassPageModel"
             Title="Les boeken">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">

            <!-- Class summary -->
            <Border Style="{StaticResource CardStyle}" BindingContext="{Binding SelectedClass}" x:DataType="models:GymClass">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Name}" Style="{StaticResource Title2}" />
                    <Label Text="{Binding DayLabel}" Style="{StaticResource Caption1Strong}" TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding TimeRange}" Style="{StaticResource Body1}" />
                    <Label Text="{Binding Room}" Style="{StaticResource Caption1}" TextColor="{StaticResource Gray500}" />
                    <Label Text="{Binding Instructor}" Style="{StaticResource Caption1}" TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>
            </Border>

            <!-- Spinning bike picker -->
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}" IsVisible="{Binding IsSpinning}">
                <Label Text="Kies je fiets" Style="{StaticResource Title2}" Margin="0,8,0,0" />
                <Label Text="Spinningzaal — 4 rijen van 6 fietsen" Style="{StaticResource Caption1}" TextColor="{StaticResource Gray500}" />

                <CollectionView ItemsSource="{Binding Bikes}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="6" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:BikeSpot">
                            <Border StrokeShape="RoundRectangle 8" StrokeThickness="1"
                                    Stroke="{StaticResource Gray200}" HeightRequest="48"
                                    BackgroundColor="{StaticResource LightSecondaryBackground}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectBikeCommand, Source={RelativeSource AncestorType={x:Type pageModels:BookClassPageModel}}, x:DataType=pageModels:BookClassPageModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsTaken}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Gray200}" />
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Number}" HorizontalOptions="Center" VerticalOptions="Center"
                                       Style="{StaticResource Caption1Strong}" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding SelectedBike.Label, StringFormat='Geselecteerd: {0}'}"
                       Style="{StaticResource Body1Strong}" TextColor="{StaticResource Primary}"
                       IsVisible="{Binding SelectedBike, Converter={StaticResource IsNotNullConverter}}" />
            </VerticalStackLayout>

            <!-- Aangemelde leden -->
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}" IsVisible="{Binding HasParticipants}">
                <Label Text="Aangemelde leden" Style="{StaticResource Title2}" Margin="0,8,0,0" />
                <CollectionView ItemsSource="{Binding Participants}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Participant">
                            <HorizontalStackLayout Spacing="12" Padding="0,4">
                                <Grid WidthRequest="40" HeightRequest="40">
                                    <!-- Uploaded photo (clipped to a circle), shown once downloaded -->
                                    <Border WidthRequest="40" HeightRequest="40" Padding="0" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 20" IsVisible="{Binding HasPhoto}">
                                        <Image Source="{Binding PhotoPath}" Aspect="AspectFill"
                                               WidthRequest="40" HeightRequest="40" />
                                    </Border>
                                    <!-- Default icon when there's no photo -->
                                    <Image WidthRequest="40" HeightRequest="40" Source="{StaticResource IconAccount}"
                                           IsVisible="{Binding HasPhoto, Converter={StaticResource InvertedBoolConverter}}" />
                                </Grid>
                                <Label Text="{Binding Username}" VerticalOptions="Center"
                                       Style="{StaticResource Body1}" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Actions -->
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" Margin="0,12,0,0"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />
            <Button Text="Boeking bevestigen" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" Margin="0,12,0,0" />
            <Button Text="Annuleren" Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Primary}" BorderWidth="1" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
