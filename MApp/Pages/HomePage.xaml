<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MApp.PageModels"
             xmlns:models="clr-namespace:MApp.Models"
             x:Class="MApp.Pages.HomePage"
             x:DataType="pageModels:HomePageModel"
             Title="BuildStronger">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">

            <!-- Hero -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                        <GradientStop Color="{StaticResource Tertiary}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Build Stronger." Style="{StaticResource Title1}" TextColor="{StaticResource White}" />
                    <Label Text="Group classes, spinning, bootcamp and more. Your gym, your pace."
                           Style="{StaticResource Body2}" TextColor="{StaticResource White}" Opacity="0.9" />
                    <Button Text="View schedule" Command="{Binding ViewScheduleCommand}"
                            BackgroundColor="{StaticResource White}" TextColor="{StaticResource Primary}"
                            HorizontalOptions="Start" Margin="0,12,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Featured classes -->
            <Label Text="Our classes" Style="{StaticResource Title2}" Margin="0,8,0,0" />
            <CollectionView ItemsSource="{Binding FeaturedClasses}" HeightRequest="160">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:GymClass">
                        <Border Style="{StaticResource CardStyle}" WidthRequest="200">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" Style="{StaticResource Title3}" />
                                <Label Text="{Binding Room}" Style="{StaticResource Caption1Strong}" TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding TimeRange}" Style="{StaticResource Body2}" />
                                <Label Text="{Binding SpotsLabel}" Style="{StaticResource Caption1}" TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Subscription plans -->
            <Label Text="Subscription plans" Style="{StaticResource Title2}" Margin="0,8,0,0" />
            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Plans}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:SubscriptionPlanInfo">
                        <Border Style="{StaticResource CardStyle}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Featured}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Title3}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Price}" Style="{StaticResource Title2}" TextColor="{StaticResource Primary}" />
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Description}"
                                       Style="{StaticResource Caption1}" TextColor="{StaticResource Gray500}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
