<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MApp.PageModels"
             x:Class="MApp.Pages.PaymentPage"
             x:DataType="pageModels:PaymentPageModel"
             Title="Betalen">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">

            <Label Text="Je bestelling" Style="{StaticResource Title2}" />

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="16">
                        <Label Grid.Row="0" Grid.Column="0" Text="Abonnement" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding PlanName}" HorizontalOptions="End" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Betaalmethode" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding PaymentMethodText}" HorizontalOptions="End" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Startdatum" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding StartDateText}" HorizontalOptions="End" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}" />

                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="Totaal" Style="{StaticResource Title2}" />
                        <Label Grid.Column="1" Text="{Binding PriceText}" Style="{StaticResource Title2}" HorizontalOptions="End" />
                    </Grid>

                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

                    <Button Text="Betalen" Command="{Binding PayCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" Margin="0,8,0,0" />
                    <Button Text="Annuleren" Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
