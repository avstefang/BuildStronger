<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MApp.PageModels"
             xmlns:models="clr-namespace:MApp.Models"
             x:Class="MApp.Pages.BookingsPage"
             x:DataType="pageModels:BookingsPageModel"
             Title="My bookings">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">

                <Label Text="Upcoming" Style="{StaticResource Title2}" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding UpcomingBookings}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Booking">
                            <Border Style="{StaticResource CardStyle}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding ClassName}" Style="{StaticResource Title3}" />
                                        <Label Text="{Binding DayLabel}" Style="{StaticResource Caption1Strong}" TextColor="{StaticResource Primary}" />
                                        <Label Text="{Binding TimeRange}" Style="{StaticResource Body2}" />
                                        <Label Text="{Binding Room}" Style="{StaticResource Caption1}" TextColor="{StaticResource Gray500}" />
                                        <Label Text="{Binding SpotLabel}" Style="{StaticResource Caption1Strong}" TextColor="{StaticResource Primary}"
                                               IsVisible="{Binding SpotLabel, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Cancel" VerticalOptions="Center"
                                            BackgroundColor="{StaticResource Error}"
                                            Command="{Binding CancelBookingCommand, Source={RelativeSource AncestorType={x:Type pageModels:BookingsPageModel}}, x:DataType=pageModels:BookingsPageModel}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Past" Style="{StaticResource Title2}" Margin="0,12,0,0" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding PastBookings}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Booking">
                            <Border Style="{StaticResource CardStyle}" Opacity="0.7">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding ClassName}" Style="{StaticResource Title3}" />
                                    <Label Text="{Binding DayLabel}" Style="{StaticResource Caption1Strong}" TextColor="{StaticResource Gray500}" />
                                    <Label Text="{Binding TimeRange}" Style="{StaticResource Body2}" />
                                    <Label Text="{Binding Status}" Style="{StaticResource Caption1}" TextColor="{StaticResource Gray500}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
