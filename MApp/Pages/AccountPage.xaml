<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MApp.PageModels"
             x:Class="MApp.Pages.AccountPage"
             x:DataType="pageModels:AccountPageModel"
             Title="Account">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">

            <!-- Profile header -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">

                    <!-- Uploaded photo (clipped to a circle), shown once downloaded -->
                    <Border HeightRequest="64" WidthRequest="64" HorizontalOptions="Center" Padding="0"
                            StrokeThickness="0" StrokeShape="RoundRectangle 32"
                            IsVisible="{Binding HasPhoto}">
                        <Image Source="{Binding PhotoPath}" Aspect="AspectFill"
                               HeightRequest="64" WidthRequest="64" />
                    </Border>

                    <!-- Default icon when there's no photo -->
                    <Image HeightRequest="64" WidthRequest="64" HorizontalOptions="Center"
                           Source="{StaticResource IconAccount}"
                           IsVisible="{Binding HasPhoto, Converter={StaticResource InvertedBoolConverter}}" />

                    <Label Text="{Binding Profile.FullName}" Style="{StaticResource Title2}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Profile.Email}" Style="{StaticResource Caption1}" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Profile.Username, StringFormat='@{0}'}" Style="{StaticResource Caption1}" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center" />

                    <Button Text="Foto wijzigen" Command="{Binding UploadPhotoCommand}" Margin="0,8,0,0"
                            HorizontalOptions="Center"
                            IsEnabled="{Binding IsUploadingPhoto, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Subscription -->
            <Label Text="Abonnement" Style="{StaticResource Title2}" Margin="0,8,0,0" IsVisible="{Binding HasSubscription}" />
            <Border Style="{StaticResource CardStyle}" IsVisible="{Binding HasSubscription}" >
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding Profile.PlanName}" Style="{StaticResource Title3}" VerticalOptions="Center" />
                        <Border Grid.Column="1" Padding="10,4" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                BackgroundColor="{Binding Color}" VerticalOptions="Center">
                            <Label Text="{Binding Profile.Status}" TextColor="{StaticResource White}" Style="{StaticResource Caption1Strong}" />
                        </Border>
                    </Grid>
                    <Label Text="Het abonnement is opgezegd en komt te vervallen na de einddatum." Style="{StaticResource Caption1}" TextColor="{StaticResource PrimaryRed}" IsVisible="{Binding IsCancelled}" />
                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Lid sinds" Style="{StaticResource Body2}" TextColor="{StaticResource Gray500}" />
                        <Label Grid.Column="1" Text="{Binding Profile.MemberSince}" Style="{StaticResource Body2Strong}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding TextEndDate}" Style="{StaticResource Body2}" TextColor="{StaticResource Gray500}" />
                        <Label Grid.Column="1" Text="{Binding Profile.RenewsOn}" Style="{StaticResource Body2Strong}" />
                    </Grid>

                    <!-- Credits this period: thin red bar inside a grey border -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding HasCreditBar}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Credits" Style="{StaticResource Body2}" TextColor="{StaticResource Gray500}" />
                            <Label Grid.Column="1" Text="{Binding CreditLabel}" Style="{StaticResource Body2Strong}" />
                        </Grid>
                        <Border StrokeThickness="1" Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 6"
                                Padding="2" BackgroundColor="{StaticResource Gray100}">
                            <ProgressBar Progress="{Binding CreditProgress}" ProgressColor="{StaticResource PrimaryRed}" HeightRequest="6" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsUnlimited}">
                        <Label Grid.Column="0" Text="Credits" Style="{StaticResource Body2}" TextColor="{StaticResource Gray500}" />
                        <Label Grid.Column="1" Text="Onbeperkt" Style="{StaticResource Body2Strong}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Abonnement bewerken" Command="{Binding ChangeSubscriptionCommand}" Margin="0,12,0,0" IsVisible="{Binding ShowChangeSubscriptionButton}" />
            <Button Text="Abonnement toevoegen" Command="{Binding AddSubscriptionCommand}" Margin="0,12,0,0" IsVisible="{Binding ShowAddSubscriptionButton}" />
            <Button Text="Profiel bewerken" Command="{Binding EditProfileCommand}" />
            <Button Text="Uitloggen" Command="{Binding LogoutCommand}"
                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Primary}" BorderWidth="1" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
